{
  "name": "@notainc/typed-api-spec",
  "version": "0.9.0",
  "scripts": {
    "install:optional-peer-dependencies": "npm install --no-save zod valibot@1 express@5 @types/express@5 fastify fastify-type-provider-zod@7",
    "build": "tsup",
    "watch:build": "tsup --watch",
    "format": "oxfmt .",
    "watch:type-check": "npx tsc --noEmit --watch",
    "test": "run-p -c test:*",
    "test:unit": "vitest run",
    "test:lint": "eslint .",
    "test:format": "oxfmt --check .",
    "test:type-check": "tsc --noEmit",
    "test:pack-smoke": "node scripts/pack-smoke.mjs",
    "test:attw": "attw --pack --profile node16"
  },
  "author": "mpppk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nota/typed-api-spec"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/path-to-regexp": "^1.7.0",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-strict-dependencies": "^1.3.35",
    "msw": "^2.7.3",
    "npm-run-all2": "^9.0.3",
    "openapi-types": "^12.1.3",
    "oxfmt": "^0.63.0",
    "supertest": "^7.2.2",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5",
    "@valibot/to-json-schema": "^1.0.0",
    "express": "^5.2.1",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "msw": "^2",
    "typescript": "^5.3 || ^6",
    "valibot": "^1.4.2",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "@types/express-serve-static-core": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "fastify-type-provider-zod": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  },
  "files": [
    "./dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./core": {
      "require": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "import": {
        "types": "./dist/core/index.d.mts",
        "default": "./dist/core/index.mjs"
      }
    },
    "./express": {
      "require": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "import": {
        "types": "./dist/express/index.d.mts",
        "default": "./dist/express/index.mjs"
      }
    },
    "./fastify": {
      "require": {
        "types": "./dist/fastify/index.d.ts",
        "default": "./dist/fastify/index.js"
      },
      "import": {
        "types": "./dist/fastify/index.d.mts",
        "default": "./dist/fastify/index.mjs"
      }
    },
    "./fetch": {
      "require": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "import": {
        "types": "./dist/fetch/index.d.mts",
        "default": "./dist/fetch/index.mjs"
      }
    },
    "./json": {
      "require": {
        "types": "./dist/json/index.d.ts",
        "default": "./dist/json/index.js"
      },
      "import": {
        "types": "./dist/json/index.d.mts",
        "default": "./dist/json/index.mjs"
      }
    },
    "./msw": {
      "require": {
        "types": "./dist/msw/index.d.ts",
        "default": "./dist/msw/index.js"
      },
      "import": {
        "types": "./dist/msw/index.d.mts",
        "default": "./dist/msw/index.mjs"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "json-schema": "^0.4.0",
    "json-schema-walker": "^2.0.0",
    "path-to-regexp": "^8.4.2"
  },
  "optionalDependencies": {
    "zod-openapi": "^5.4.6"
  }
}
