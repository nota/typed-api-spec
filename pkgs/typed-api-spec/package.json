{
  "name": "@notainc/typed-api-spec",
  "version": "0.9.0",
  "scripts": {
    "install:optional-peer-dependencies": "npm install --no-save zod valibot@1 express@5 @types/express@5 fastify fastify-type-provider-zod@7",
    "build": "run-s build:clean build:cjs build:esm build:pkg",
    "build:clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:pkg": "node scripts/write-dist-package-json.mjs",
    "watch:build": "run-s build:clean build:pkg && run-p \"build:cjs -- --watch\" \"build:esm -- --watch\"",
    "format": "oxfmt .",
    "watch:type-check": "npx tsc --noEmit --watch",
    "test": "run-p -c test:*",
    "test:unit": "vitest run",
    "test:lint": "oxlint .",
    "test:format": "oxfmt --check .",
    "test:type-check": "tsc --noEmit",
    "test:pack-smoke": "node scripts/pack-smoke.mjs",
    "test:attw": "attw --pack --profile node16 && attw --pack --entrypoints ."
  },
  "author": "mpppk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nota/typed-api-spec"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/path-to-regexp": "^1.7.0",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^7.2.1",
    "eslint-plugin-strict-dependencies": "^1.3.35",
    "msw": "^2.7.3",
    "npm-run-all2": "^9.0.3",
    "openapi-types": "^12.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.85.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5",
    "@valibot/to-json-schema": "^1.0.0",
    "express": "^5.2.1",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "msw": "^2",
    "typescript": "^5.3 || ^6",
    "valibot": "^1.4.2",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "@types/express-serve-static-core": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "fastify-type-provider-zod": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  },
  "files": [
    "./dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./core": {
      "require": {
        "types": "./dist/cjs/core/index.d.ts",
        "default": "./dist/cjs/core/index.js"
      },
      "import": {
        "types": "./dist/esm/core/index.d.ts",
        "default": "./dist/esm/core/index.js"
      }
    },
    "./express": {
      "require": {
        "types": "./dist/cjs/express/index.d.ts",
        "default": "./dist/cjs/express/index.js"
      },
      "import": {
        "types": "./dist/esm/express/index.d.ts",
        "default": "./dist/esm/express/index.js"
      }
    },
    "./fastify": {
      "require": {
        "types": "./dist/cjs/fastify/index.d.ts",
        "default": "./dist/cjs/fastify/index.js"
      },
      "import": {
        "types": "./dist/esm/fastify/index.d.ts",
        "default": "./dist/esm/fastify/index.js"
      }
    },
    "./fetch": {
      "require": {
        "types": "./dist/cjs/fetch/index.d.ts",
        "default": "./dist/cjs/fetch/index.js"
      },
      "import": {
        "types": "./dist/esm/fetch/index.d.ts",
        "default": "./dist/esm/fetch/index.js"
      }
    },
    "./json": {
      "require": {
        "types": "./dist/cjs/json/index.d.ts",
        "default": "./dist/cjs/json/index.js"
      },
      "import": {
        "types": "./dist/esm/json/index.d.ts",
        "default": "./dist/esm/json/index.js"
      }
    },
    "./msw": {
      "require": {
        "types": "./dist/cjs/msw/index.d.ts",
        "default": "./dist/cjs/msw/index.js"
      },
      "import": {
        "types": "./dist/esm/msw/index.d.ts",
        "default": "./dist/esm/msw/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "json-schema": "^0.4.0",
    "json-schema-walker": "^2.0.0",
    "openapi-types": "^12.1.3",
    "path-to-regexp": "^8.4.2"
  },
  "optionalDependencies": {
    "zod-openapi": "^5.4.6"
  }
}
